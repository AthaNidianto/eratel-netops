# Salin jadi .env lalu isi.
HOST_PORT=8080

# Akun panel pertama (hanya dipakai saat database masih kosong).
# Jika ADMIN_PASSWORD dikosongkan, password acak dicetak ke log: docker compose logs netops
ADMIN_USER=admin
ADMIN_PASSWORD=

# Kunci enkripsi password perangkat: base64 dari 32 byte.
# Buat dengan: openssl rand -base64 32
# Jika kosong, kunci dibuat otomatis di volume data (/var/www/data/app.key).
# Simpan kunci ini, tanpa kunci yang sama password perangkat tidak bisa dibuka lagi.
APP_KEY=

# 1 = isi daftar awal 12 CRS (app/seed.php) saat tabel perangkat masih kosong.
SEED_CRS=1
